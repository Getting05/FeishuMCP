{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feishu-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "FEISHU_EVENTS", "class_name": "FeishuEventStore" }] },
  "migrations": [{ "tag": "v1-events", "new_sqlite_classes": ["FeishuEventStore"] }]
}
